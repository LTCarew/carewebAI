# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/
.env/

# Django database
db.sqlite3
*/db.sqlite3

# Media / static files
media/
staticfiles/

# Environment variables
.env
*.env

# Logs
*.log

# VSCode
.vscode/

# macOS
.DS_Store

# Python packaging
*.egg-info/
dist/
build/

