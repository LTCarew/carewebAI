
# ==========================================
# Python
# ==========================================

# Python cache directories
__pycache__/
**/__pycache__/

# Compiled Python files
*.py[cod]
*$py.class

# Python packaging
*.egg-info/
*.egg/
dist/
build/
*.whl

# ==========================================
# Virtual Environments
# ==========================================

.venv/
venv/
env/
ENV/

# ==========================================
# Environment Variables and Secrets
# ==========================================

.env
.env.*
!.env.example
*.env

# ==========================================
# Django
# ==========================================

# Local SQLite databases
db.sqlite3
*.sqlite3
*.sqlite3-journal

# User-uploaded media
media/

# Collected static files
staticfiles/

# Django / Python logs
*.log

# ==========================================
# Testing and Coverage
# ==========================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ==========================================
# IDEs and Editors
# ==========================================

# Visual Studio Code
.vscode/

# PyCharm / JetBrains
.idea/

# Temporary editor files
*.swp
*.swo
*~

# ==========================================
# Operating System Files
# ==========================================

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# ==========================================
# Terraform
# ==========================================

# Terraform variable files and secrets
infra/terraform/*.tfvars
infra/terraform/*.tfvars.json

# Allow example Terraform variables
!infra/terraform/terraform.tfvars.example

# Terraform working directory
infra/terraform/.terraform/

# Terraform state files
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*

# Terraform crash logs
infra/terraform/crash.log
infra/terraform/crash.*.log

# Terraform override files
infra/terraform/override.tf
infra/terraform/override.tf.json
infra/terraform/*_override.tf
infra/terraform/*_override.tf.json

# ==========================================
# Temporary and Backup Files
# ==========================================

*.tmp
*.temp
*.bak
*.backup
